---
import snapshot from '../data/today-events.json';

const events = Array.isArray((snapshot as any)?.events) ? (snapshot as any).events : [];
const date = (snapshot as any)?.date || new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Riyadh',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date());
const upcomingDays = Number((snapshot as any)?.upcomingDays || 8);
const labels = {
  football: { name: 'كرة القدم', icon: '/brand/icon-football.svg' },
  nba: { name: 'NBA', icon: '/brand/icon-basketball.svg' },
  mma: { name: 'MMA / UFC', icon: '/brand/icon-mma.svg' },
  wwe: { name: 'WWE', icon: '/brand/icon-wwe.svg' }
};
const nameAliases = [
  ['Al Hilal','الهلال'],['Al Nassr FC','النصر'],['Al Nassr','النصر'],['Al Ittihad','الاتحاد'],['Al Ahli','الأهلي'],['Al Qadsiah','القادسية'],['Al Shabab','الشباب'],
  ['Real Madrid','ريال مدريد'],['Barcelona','برشلونة'],['Liverpool','ليفربول'],['Arsenal','أرسنال'],['Chelsea','تشيلسي'],['Man United','مانشستر يونايتد'],['Manchester United','مانشستر يونايتد'],['Man City','مانشستر سيتي'],['Manchester City','مانشستر سيتي'],['Juventus','يوفنتوس'],['Milan','ميلان'],['Inter','إنتر ميلان']
];
const competitionAliases = [
  ['Saudi Pro League','دوري روشن السعودي'],['Premier League','الدوري الإنجليزي الممتاز'],['LaLiga','الدوري الإسباني'],['La Liga','الدوري الإسباني'],['Serie A','الدوري الإيطالي'],['Bundesliga','الدوري الألماني'],['Ligue 1','الدوري الفرنسي'],['Champions League','دوري أبطال أوروبا'],['King Cup','كأس خادم الحرمين الشريفين']
];
const replaceAliases = (value='', aliases:any[]) => aliases.reduce((text,[from,to]) => text.replace(new RegExp(`\\b${from.replace(/[.*+?^${}()|[\]\\]/g,'\\$&')}\\b`,'gi'),to),String(value || ''));
const eventTitle = (event:any) => event.sport === 'football' ? replaceAliases(event.title, nameAliases) : event.title;
const eventSubtitle = (event:any) => event.sport === 'football' ? replaceAliases(event.subtitle, competitionAliases) : event.subtitle;
const counts = Object.fromEntries(Object.keys(labels).map((key) => [key, events.filter((event:any) => event.sport === key).length]));
const visibleEvents = events;
const generatedAt = (snapshot as any)?.generatedAt;
const localDate = (value:any) => new Intl.DateTimeFormat('en-CA',{timeZone:'Asia/Riyadh',year:'numeric',month:'2-digit',day:'2-digit'}).format(new Date(value));
const eventTime = (value='') => {
  try { return new Intl.DateTimeFormat('ar-SA-u-nu-latn',{timeZone:'Asia/Riyadh',hour:'numeric',minute:'2-digit'}).format(new Date(value)); }
  catch { return ''; }
};
const eventDay = (value='') => {
  try { return new Intl.DateTimeFormat('ar-SA-u-nu-latn',{timeZone:'Asia/Riyadh',weekday:'short',day:'numeric',month:'short'}).format(new Date(value)); }
  catch { return ''; }
};
const stateLabel = (event:any) => {
  if (event.state === 'live') return 'مباشر الآن';
  if (event.state === 'final') return 'انتهت';
  if (event.scope === 'today' || localDate(event.start) === date) return 'اليوم / الليلة';
  return eventDay(event.start) || 'قريبًا';
};
const todayArabic = (() => {
  try { return new Intl.DateTimeFormat('ar-SA-u-nu-latn',{timeZone:'Asia/Riyadh',weekday:'long',day:'numeric',month:'long'}).format(new Date(`${date}T12:00:00+03:00`)); }
  catch { return 'اليوم'; }
})();
const displayScore = (event:any) => ['live','final'].includes(event.state) ? String(event.score || '').trim() : '';
---
<section class="today-widget" aria-labelledby="today-sports-title" data-today-widget>
  <div class="today-head">
    <div>
      <span class="section-kicker">LIVE SPORTS RADAR</span>
      <h2 id="today-sports-title">مباريات وأحداث اليوم والقادم</h2>
      <p>{todayArabic} • بتوقيت السعودية • رادار حتى {upcomingDays} أيام لـ UFC وWWE</p>
    </div>
    <a class="today-more" href="/matches/today">عرض مباريات اليوم ←</a>
  </div>

  <div class="sport-tabs" role="tablist" aria-label="تصفية الأحداث">
    <button class="active" type="button" data-sport-tab="all" aria-pressed="true"><span class="tab-flame">●</span> الكل <b>{events.length}</b></button>
    {Object.entries(labels).map(([key, item]:any) => (
      <button type="button" data-sport-tab={key} aria-pressed="false"><img src={item.icon} width="18" height="18" alt="" /> {item.name} <b>{counts[key] || 0}</b></button>
    ))}
  </div>

  {visibleEvents.length ? (
    <div class="today-events" data-event-list>
      {visibleEvents.map((event:any) => {
        const score = displayScore(event);
        const label = labels[event.sport] || {name:event.sportLabel,icon:'/brand/icon-sports.svg'};
        return <a
          class:list={["today-event", { live: event.state === 'live', upcoming: event.scope === 'upcoming' }]}
          data-sport-event={event.sport}
          href={event.url || '/matches/today'}
          target={event.internal ? undefined : '_blank'}
          rel={event.internal ? undefined : 'nofollow noopener'}
        >
          <div class="event-top">
            <span class="sport-chip"><img src={label.icon} width="18" height="18" alt="" /> {label.name}</span>
            <span class:list={["event-state", { live: event.state === 'live', upcoming: event.scope === 'upcoming' }]}>{event.state === 'live' && <i></i>}{stateLabel(event)}</span>
          </div>
          <h3>{eventTitle(event)}</h3>
          <p>{eventSubtitle(event)}</p>
          <div class="event-bottom">
            <b>{score || eventTime(event.start)}</b>
            <small>{score ? eventTime(event.start) : `${eventDay(event.start)} • ${event.source}`}</small>
          </div>
        </a>;
      })}
    </div>
  ) : (
    <div class="today-empty"><strong>لا توجد أحداث مسجلة ضمن الرادار حتى الآن</strong><p>يتم تحديث كرة القدم وNBA وUFC وWWE تلقائيًا مع كل تحديث للموقع.</p></div>
  )}

  <div class="today-empty filtered-empty" hidden data-filter-empty><strong>لا توجد أحداث لهذه الرياضة ضمن الرادار الحالي</strong></div>
  <div class="today-foot"><span class="live-dot"></span> تحديث تلقائي{generatedAt ? ` • آخر مزامنة ${eventTime(generatedAt)}` : ''} • UFC: Tapology • WWE: WWE.com</div>
</section>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-today-widget]').forEach((widget) => {
      const tabs = [...widget.querySelectorAll('[data-sport-tab]')];
      const cards = [...widget.querySelectorAll('[data-sport-event]')];
      const empty = widget.querySelector('[data-filter-empty]');
      tabs.forEach((tab) => tab.addEventListener('click', () => {
        const sport = tab.getAttribute('data-sport-tab');
        tabs.forEach((item) => {
          const active = item === tab;
          item.classList.toggle('active', active);
          item.setAttribute('aria-pressed', active ? 'true' : 'false');
        });
        let shown = 0;
        cards.forEach((card) => {
          const visible = sport === 'all' || card.getAttribute('data-sport-event') === sport;
          card.hidden = !visible;
          if (visible) shown += 1;
        });
        if (empty) empty.hidden = shown !== 0;
      }));
    });
  });
</script>

<style>
.today-widget{position:relative;overflow:hidden;margin:18px 0 8px;border:1px solid #5b3a865e;border-radius:22px;background:radial-gradient(circle at 85% 0,#6e268f24,transparent 23rem),linear-gradient(145deg,#111724,#090d14);padding:22px;box-shadow:0 22px 55px #0005}.today-widget:after{content:"";position:absolute;inset:auto -90px -120px auto;width:280px;height:280px;background:radial-gradient(circle,#22d3ee16,transparent 68%);pointer-events:none}.today-head{position:relative;z-index:1;display:flex;justify-content:space-between;align-items:end;gap:16px;margin-bottom:17px}.today-head h2{font-size:29px;line-height:1.15;margin:3px 0}.today-head p{margin:0;color:var(--muted);font-size:10px}.today-more{font-size:11px;color:var(--cyan);font-weight:900}.sport-tabs{position:relative;z-index:1;display:flex;gap:7px;overflow:auto;padding-bottom:12px;scrollbar-width:none}.sport-tabs button{display:inline-flex;align-items:center;gap:5px;border:1px solid var(--line);background:#090e15;color:#cbd5e4;border-radius:10px;padding:7px 10px;white-space:nowrap;cursor:pointer;font:inherit;font-size:10px}.sport-tabs button img{width:17px;height:17px}.sport-tabs button b{display:inline-grid;place-items:center;min-width:17px;height:17px;border-radius:999px;background:#171d29;color:var(--cyan);font-size:8px;margin-inline-start:2px}.sport-tabs button.active{border-color:#a855f78c;background:linear-gradient(90deg,#c026d31e,#22d3ee15);color:#fff;box-shadow:0 0 20px #d946ef18}.tab-flame{color:#d946ef;text-shadow:0 0 12px #d946ef}.today-events{position:relative;z-index:1;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:9px}.today-event{display:flex;flex-direction:column;min-height:155px;padding:14px;border:1px solid var(--line);border-radius:14px;background:linear-gradient(180deg,#0f151f,#090d14);color:inherit}.today-event:hover{color:inherit;border-color:#8b5cf66b;transform:translateY(-1px);box-shadow:0 14px 30px #0005}.today-event.live{border-color:#ff4d6d6a;box-shadow:inset 0 0 0 1px #ff4d6d12}.today-event.upcoming{border-color:#22d3ee26}.event-top,.event-bottom{display:flex;justify-content:space-between;align-items:center;gap:8px}.sport-chip{display:flex;align-items:center;gap:4px;font-size:8px;color:#e9c7f5;font-weight:900}.sport-chip img{width:17px;height:17px}.event-state{font-size:8px;color:var(--muted);display:flex;align-items:center;gap:5px}.event-state.live{color:#ff8395}.event-state.upcoming{color:var(--cyan)}.event-state i{width:6px;height:6px;border-radius:50%;background:#ff4d6d;box-shadow:0 0 0 4px #ff4d6d16,0 0 14px #ff4d6d}.today-event h3{font-size:14px;line-height:1.5;margin:9px 0 4px}.today-event p{font-size:9px;color:var(--muted);margin:0 0 auto}.event-bottom{border-top:1px solid var(--line-soft);padding-top:9px;margin-top:11px}.event-bottom b{font-size:14px;color:#fff}.event-bottom small{font-size:8px;color:var(--muted)}.today-foot{position:relative;z-index:1;display:flex;align-items:center;gap:7px;color:var(--muted);font-size:8px;margin-top:12px;flex-wrap:wrap}.today-empty{border:1px dashed var(--line);border-radius:14px;padding:21px;text-align:center;color:var(--muted)}.today-empty strong{color:#e3e9f1}.today-empty p{margin:5px 0 0;font-size:10px}.filtered-empty{margin-top:4px}@media(max-width:980px){.today-events{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:600px){.today-widget{padding:16px;border-radius:18px}.today-head{align-items:start;flex-direction:column}.today-head h2{font-size:24px}.today-events{grid-template-columns:1fr}.today-event{min-height:132px}.today-more{display:none}}
</style>
