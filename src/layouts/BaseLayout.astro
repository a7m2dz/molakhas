---
import '../styles/global.css';
import '../styles/enhancements.css';
import LurvuePromo from '../components/LurvuePromo.astro';
import { sections } from '../data/sections';

const {
  title = 'ملخص | أخبار الرياضة',
  description = 'أهم الأخبار الرياضية العربية والعالمية بسرعة ووضوح.',
  section = 'general',
  type = 'website',
  publishedAt,
  modifiedAt,
  image,
  imageAlt,
  imageType,
  imageWidth,
  imageHeight,
  tags = [],
  robots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1',
  schemaExtra = []
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).toString().replace(/\/$/, '');
const imageUrl = image ? new URL(image, `${siteUrl}/`).toString() : null;
const extras = Array.isArray(schemaExtra) ? schemaExtra : [schemaExtra].filter(Boolean);
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'ملخص',
      alternateName: 'Molakhas',
      url: siteUrl,
      logo: {'@type':'ImageObject',url:`${siteUrl}/brand/molakhas-logo.png`,width:512,height:512}
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'ملخص',
      alternateName: 'Molakhas',
      url: siteUrl,
      inLanguage: 'ar',
      publisher: {'@id': `${siteUrl}/#organization`},
      description: 'منصة رياضية عربية تركز على الأخبار المهمة بدون حشو.'
    },
    ...extras
  ]
};
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#07101d" />
    <meta name="generator" content="Astro" />
    <meta name="author" content="فريق تحرير ملخص" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ar" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="ملخص RSS" href="/rss.xml" />
    {imageUrl && <link rel="preload" as="image" href={imageUrl} fetchpriority="high" />}
    <meta property="og:locale" content="ar_SA" />
    <meta property="og:site_name" content="ملخص" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:secure_url" content={imageUrl} />}
    {imageUrl && imageType && <meta property="og:image:type" content={imageType} />}
    {imageUrl && imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageUrl && imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    {imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}
    {type === 'article' && <meta property="article:author" content={`${siteUrl}/authors/editorial-team`} />}
    {type === 'article' && section && <meta property="article:section" content={section} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {imageUrl && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">تجاوز إلى المحتوى</a>
    <div class="top-promo"><LurvuePromo section={section} compact position="topbar" /></div>
    <header class="site-header">
      <a class="brand" href="/" aria-label="ملخص - الرئيسية"><span>مُلخّص</span><small>الرياضة بدون حشو</small></a>
      <nav aria-label="الأقسام">
        <a href="/latest">آخر الأخبار</a>
        <a href="/matches/today">مباريات اليوم</a>
        <a href="/teams">الفرق</a>
        <a href="/competitions">البطولات</a>
        {sections.map((item) => <a href={`/${item.slug}`}>{item.name}</a>)}
      </nav>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      {type !== 'article' && <LurvuePromo section={section} position="footer" />}
      <div class="footer-row">
        <div><b>مُلخّص</b><p>أخبار رياضية مختصرة، واضحة، ومحدثة.</p></div>
        <div class="footer-links"><a href="/latest">آخر الأخبار</a><a href="/matches/today">مباريات اليوم</a><a href="/teams">الفرق</a><a href="/competitions">البطولات</a><a href="/about">عن ملخص</a><a href="/editorial-policy">سياسة التحرير</a><a href="/corrections">التصحيحات</a><a href="/contact">تواصل</a><a href="/privacy">الخصوصية</a><a href="/disclosure">الإفصاح الإعلاني</a><a href="/rss.xml">RSS</a></div>
      </div>
      <small>© {new Date().getFullYear()} ملخص. جميع الحقوق محفوظة.</small>
    </footer>
  </body>
</html>
