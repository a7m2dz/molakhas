---
import '../styles/global.css';
import '../styles/enhancements.css';
import LurvuePromo from '../components/LurvuePromo.astro';
import { sections } from '../data/sections';

const {
  title = 'ملخص | أخبار الرياضة والترفيه',
  description = 'أهم الأخبار الرياضية والترفيهية العربية والعالمية بسرعة ووضوح.',
  section = 'general',
  type = 'website',
  publishedAt,
  modifiedAt,
  image,
  imageAlt,
  imageType,
  imageWidth,
  imageHeight,
  tags = [],
  robots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1',
  schemaExtra = []
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).toString().replace(/\/$/, '');
const imageUrl = image ? new URL(image, `${siteUrl}/`).toString() : null;
const extras = Array.isArray(schemaExtra) ? schemaExtra : [schemaExtra].filter(Boolean);
const storeUrl = new URL('https://lurvue.com');
storeUrl.searchParams.set('utm_source','molakhas');
storeUrl.searchParams.set('utm_medium','header');
storeUrl.searchParams.set('utm_campaign','molakhas-brand-shell');
const primaryNav = [
  { href: '/', label: 'الرئيسية' },
  { href: '/latest', label: 'الأخبار' },
  { href: '/matches/today', label: 'مباريات اليوم' },
  { href: '/football', label: 'كرة القدم' },
  { href: '/ufc', label: 'MMA / UFC' },
  { href: '/basketball', label: 'كرة السلة' },
  { href: '/wwe', label: 'WWE' },
  { href: '/movies', label: 'الأفلام' },
  { href: '/tv', label: 'المسلسلات' },
  { href: '/saudi', label: 'السعودية' },
  { href: '/competitions', label: 'البطولات' },
  { href: '/teams', label: 'الفرق' }
];
const footerSections = sections.filter((item) => ['football','basketball','ufc','wwe','movies','tv','saudi','transfers'].includes(item.slug));
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'ملخص',
      alternateName: 'Molakhas',
      url: siteUrl,
      logo: {'@type':'ImageObject',url:`${siteUrl}/brand/molakhas-mark.svg`}
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'ملخص',
      alternateName: 'Molakhas',
      url: siteUrl,
      inLanguage: 'ar',
      publisher: {'@id': `${siteUrl}/#organization`},
      description: 'منصة عربية تجمع الأخبار الرياضية والترفيهية، مركز المباريات، الأفلام والمسلسلات في تجربة سريعة ومختصرة.'
    },
    ...extras
  ]
};
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#080B0F" />
    <meta name="generator" content="Astro" />
    <meta name="author" content="فريق تحرير ملخص" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ar" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="ملخص RSS" href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/brand/molakhas-mark.svg" />
    <link rel="apple-touch-icon" href="/brand/molakhas-mark.svg" />
    {imageUrl && <link rel="preload" as="image" href={imageUrl} fetchpriority="high" />}
    <meta property="og:locale" content="ar_SA" />
    <meta property="og:site_name" content="ملخص" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:secure_url" content={imageUrl} />}
    {imageUrl && imageType && <meta property="og:image:type" content={imageType} />}
    {imageUrl && imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {imageUrl && imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    {imageUrl && imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}
    {type === 'article' && <meta property="article:author" content={`${siteUrl}/authors/editorial-team`} />}
    {type === 'article' && section && <meta property="article:section" content={section} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    {imageUrl && imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">تجاوز إلى المحتوى</a>
    <div class="top-promo"><LurvuePromo section={section} compact position="topbar" /></div>
    <header class="site-header-wrap">
      <div class="site-header">
        <a class="brand brand-lockup" href="/" aria-label="ملخص - الرئيسية">
          <span class="brand-copy"><strong>ملخص</strong><small>MOLAKHAS</small></span>
          <img class="brand-mark" src="/brand/molakhas-mark.svg" width="58" height="58" alt="" aria-hidden="true" />
        </a>
        <nav aria-label="التنقل الرئيسي">
          {primaryNav.map((item) => <a class:list={[{ active: Astro.url.pathname === item.href || (item.href !== '/' && Astro.url.pathname.startsWith(item.href)) }]} href={item.href}>{item.label}</a>)}
        </nav>
        <a class="store-cta" href={storeUrl.toString()} target="_blank" rel="sponsored nofollow noopener"><span>▣</span> متجر لورفيو</a>
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      {type !== 'article' && <LurvuePromo section={section} position="footer" />}
      <div class="footer-main">
        <div class="footer-brand">
          <a class="footer-brand-lockup" href="/" aria-label="ملخص - الرئيسية">
            <span class="brand-copy"><strong>ملخص</strong><small>MOLAKHAS</small></span>
            <img class="brand-mark" src="/brand/molakhas-mark.svg" width="66" height="66" alt="" aria-hidden="true" />
          </a>
          <p>SPORTS × ENTERTAINMENT × A BRIGHTER FEED</p><small>الأهم أولًا. بدون حشو.</small>
        </div>
        <div class="footer-col"><b>روابط سريعة</b><a href="/">الرئيسية</a><a href="/latest">آخر الأخبار</a><a href="/matches/today">مباريات اليوم</a><a href="/movies">الأفلام</a><a href="/tv">المسلسلات</a><a href="/teams">الفرق</a><a href="/competitions">البطولات</a></div>
        <div class="footer-col"><b>الأقسام</b>{footerSections.map((item) => <a href={`/${item.slug}`}>{item.name}</a>)}</div>
        <div class="footer-col"><b>عن ملخص</b><a href="/about">من نحن</a><a href="/editorial-policy">سياسة التحرير</a><a href="/corrections">التصحيحات</a><a href="/contact">تواصل</a><a href="/privacy">الخصوصية</a><a href="/disclosure">الإفصاح الإعلاني</a></div>
      </div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} ملخص. جميع الحقوق محفوظة.</span><a href="/rss.xml">RSS</a><span class="footer-slogan">أكثر من مجرد ملخص</span></div>
    </footer>
  </body>
</html>
