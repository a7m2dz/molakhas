---
import '../styles/global.css';
import '../styles/enhancements.css';
import LurvuePromo from '../components/LurvuePromo.astro';
import AdsterraAd from '../components/AdsterraAd.astro';
import { sections } from '../data/sections';

const {
  title = 'ملخص | أخبار الرياضة والترفيه',
  description = 'أهم الأخبار الرياضية والترفيهية العربية والعالمية بسرعة ووضوح.',
  section = 'general',
  type = 'website',
  publishedAt,
  modifiedAt,
  image,
  imageAlt,
  imageType,
  imageWidth,
  imageHeight,
  tags = [],
  robots = 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1',
  schemaExtra = []
} = Astro.props;

// Cap overlong <title> at ~72 chars while preserving the trailing brand suffix ("| ملخص").
const docTitle = (() => {
  const t = String(title);
  if (t.length <= 72) return t;
  const parts = t.split(' | ');
  const brand = parts.length > 1 ? parts.pop() : '';
  const main = parts.join(' | ');
  const budget = Math.max(30, 72 - (brand ? brand.length + 3 : 0));
  const mainTrimmed = main.length > budget ? main.slice(0, budget).trimEnd().replace(/[،\s]+$/u, '') + '…' : main;
  return brand ? `${mainTrimmed} | ${brand}` : mainTrimmed;
})();
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).toString().replace(/\/$/, '');
const imageUrl = image ? new URL(image, `${siteUrl}/`).toString() : null;
// Every page gets a valid share image — real hero when present, brand default otherwise.
const ogImageUrl = imageUrl || `${siteUrl}/brand/og-default.png`;
const ogImageType = imageType || (imageUrl ? undefined : 'image/png');
const ogImageWidth = imageWidth || 1200;
const ogImageHeight = imageHeight || 630;
const extras = Array.isArray(schemaExtra) ? schemaExtra : [schemaExtra].filter(Boolean);
const storeUrl = new URL('https://lurvue.com');
storeUrl.searchParams.set('utm_source','molakhas');
storeUrl.searchParams.set('utm_medium','header');
storeUrl.searchParams.set('utm_campaign','molakhas-brand-shell');
const primaryNav = [
  { href: '/', label: 'الرئيسية' },
  { href: '/latest', label: 'الأخبار' },
  { href: '/matches/today', label: 'مباريات اليوم' },
  { href: '/football', label: 'كرة القدم' },
  { href: '/ufc', label: 'MMA / UFC' },
  { href: '/basketball', label: 'كرة السلة' },
  { href: '/wwe', label: 'WWE' },
  { href: '/movies', label: 'الأفلام' },
  { href: '/tv', label: 'المسلسلات' },
  { href: '/saudi', label: 'السعودية' },
  { href: '/competitions', label: 'البطولات' },
  { href: '/teams', label: 'الفرق' }
];
const footerSections = sections.filter((item) => ['football','basketball','ufc','wwe','movies','tv','saudi','transfers'].includes(item.slug));
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#organization`,
      name: 'ملخص',
      alternateName: 'Molakhas',
      url: siteUrl,
      logo: {'@type':'ImageObject',url:`${siteUrl}/brand/molakhas-mark.svg`}
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'ملخص',
      alternateName: 'Molakhas',
      url: siteUrl,
      inLanguage: 'ar',
      publisher: {'@id': `${siteUrl}/#organization`},
      description: 'منصة عربية تجمع الأخبار الرياضية والترفيهية، مركز المباريات، الأفلام والمسلسلات في تجربة سريعة ومختصرة.'
    },
    ...extras
  ]
};
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#080B0F" />
    <meta name="generator" content="Astro" />
    <meta name="author" content="فريق تحرير ملخص" />
    <meta name="monetag" content="f5188a2e6a8296c3ffb06fbc632cbc36" />
    <!-- Monetag ad tags: kept high in <head> per Monetag publisher guidance. -->
    <!-- Monetag: Popunder / OnClick (zone 11758229) -->
    <script is:inline>(function(s){s.dataset.zone='11758229',s.src='https://al5sm.com/tag.min.js'})([document.documentElement, document.body].filter(Boolean).pop().appendChild(document.createElement('script')))</script>
    <!-- Monetag: In-Page Push (zone 11757771) -->
    <script is:inline>(function(s){s.dataset.zone='11757771',s.src='https://nap5k.com/tag.min.js'})([document.documentElement, document.body].filter(Boolean).pop().appendChild(document.createElement('script')))</script>
    <!-- Monetag: Vignette banner (zone 11757773) -->
    <script is:inline>(function(s){s.dataset.zone='11757773',s.src='https://n6wxm.com/vignette.min.js'})([document.documentElement, document.body].filter(Boolean).pop().appendChild(document.createElement('script')))</script>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-X85PYZYJ76"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-X85PYZYJ76');
    </script>
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ar" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="ملخص RSS" href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/brand/molakhas-mark.svg" />
    <link rel="apple-touch-icon" href="/brand/molakhas-mark.svg" />
    {imageUrl && <link rel="preload" as="image" href={imageUrl} fetchpriority="high" />}
    <meta property="og:locale" content="ar_SA" />
    <meta property="og:site_name" content="ملخص" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    {ogImageType && <meta property="og:image:type" content={ogImageType} />}
    <meta property="og:image:width" content={String(ogImageWidth)} />
    <meta property="og:image:height" content={String(ogImageHeight)} />
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    {type === 'article' && publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {type === 'article' && modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}
    {type === 'article' && <meta property="article:author" content={`${siteUrl}/authors/editorial-team`} />}
    {type === 'article' && section && <meta property="article:section" content={section} />}
    {type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {imageAlt && <meta name="twitter:image:alt" content={imageAlt} />}
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <title>{docTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">تجاوز إلى المحتوى</a>
    <div class="top-promo"><LurvuePromo section={section} compact position="topbar" /></div>
    <header class="site-header-wrap">
      <div class="site-header">
        <a class="brand brand-lockup" href="/" aria-label="ملخص - الرئيسية">
          <span class="brand-copy"><strong>ملخص</strong><small>MOLAKHAS</small></span>
          <img class="brand-mark" src="/brand/molakhas-mark.svg" width="58" height="58" alt="" aria-hidden="true" />
        </a>
        <nav aria-label="التنقل الرئيسي">
          {primaryNav.map((item) => <a class:list={[{ active: Astro.url.pathname === item.href || (item.href !== '/' && Astro.url.pathname.startsWith(item.href)) }]} href={item.href}>{item.label}</a>)}
        </nav>
        <a class="store-cta" href={storeUrl.toString()} target="_blank" rel="sponsored nofollow noopener"><span>▣</span> متجر لورفيو</a>
      </div>
    </header>
    <div class="shell">
      <AdsterraAd variant="leaderboard" />
      <AdsterraAd variant="mobile" />
    </div>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      {type !== 'article' && <LurvuePromo section={section} position="footer" />}
      <div class="footer-main">
        <div class="footer-brand">
          <a class="footer-brand-lockup" href="/" aria-label="ملخص - الرئيسية">
            <span class="brand-copy"><strong>ملخص</strong><small>MOLAKHAS</small></span>
            <img class="brand-mark" src="/brand/molakhas-mark.svg" width="66" height="66" alt="" aria-hidden="true" />
          </a>
          <p>SPORTS × ENTERTAINMENT × A BRIGHTER FEED</p><small>الأهم أولًا. بدون حشو.</small>
        </div>
        <div class="footer-col"><b>روابط سريعة</b><a href="/">الرئيسية</a><a href="/latest">آخر الأخبار</a><a href="/matches/today">مباريات اليوم</a><a href="/movies">الأفلام</a><a href="/tv">المسلسلات</a><a href="/teams">الفرق</a><a href="/competitions">البطولات</a></div>
        <div class="footer-col"><b>الأقسام</b>{footerSections.map((item) => <a href={`/${item.slug}`}>{item.name}</a>)}</div>
        <div class="footer-col"><b>عن ملخص</b><a href="/about">من نحن</a><a href="/editorial-policy">سياسة التحرير</a><a href="/corrections">التصحيحات</a><a href="/contact">تواصل</a><a href="/privacy">الخصوصية</a><a href="/disclosure">الإفصاح الإعلاني</a></div>
      </div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} ملخص. جميع الحقوق محفوظة.</span><a href="/rss.xml">RSS</a><span class="footer-slogan">أكثر من مجرد ملخص</span></div>
    </footer>
  </body>
</html>