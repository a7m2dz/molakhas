---
import '../styles/global.css';
import LurvuePromo from '../components/LurvuePromo.astro';
import { sections } from '../data/sections';

const {
  title = 'ملخص | أخبار الرياضة',
  description = 'أهم الأخبار الرياضية العربية والعالمية بسرعة ووضوح.',
  section = 'general',
  type = 'website',
  publishedAt
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString();
const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).toString().replace(/\/$/, '');
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'ملخص',
  alternateName: 'Molakhas',
  url: siteUrl,
  inLanguage: 'ar',
  description: 'منصة رياضية عربية تركز على الأخبار المهمة بدون حشو.'
};
---
<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="theme-color" content="#07101d" />
    <meta name="generator" content="Astro" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title="ملخص RSS" href="/rss.xml" />
    <meta property="og:locale" content="ar_SA" />
    <meta property="og:site_name" content="ملخص" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">تجاوز إلى المحتوى</a>
    <div class="top-promo"><LurvuePromo section={section} compact /></div>
    <header class="site-header">
      <a class="brand" href="/" aria-label="ملخص - الرئيسية"><span>مُلخّص</span><small>الرياضة بدون حشو</small></a>
      <nav aria-label="الأقسام">
        {sections.map((item) => <a href={`/${item.slug}`}>{item.name}</a>)}
      </nav>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer">
      <LurvuePromo section={section} />
      <div class="footer-row">
        <div><b>مُلخّص</b><p>أخبار رياضية مختصرة، واضحة، ومحدثة.</p></div>
        <div class="footer-links"><a href="/about">عن ملخص</a><a href="/privacy">الخصوصية</a><a href="/disclosure">الإفصاح الإعلاني</a><a href="/rss.xml">RSS</a></div>
      </div>
      <small>© {new Date().getFullYear()} ملخص. جميع الحقوق محفوظة.</small>
    </footer>
  </body>
</html>
