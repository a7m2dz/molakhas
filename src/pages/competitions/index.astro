---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LurvuePromo from '../../components/LurvuePromo.astro';
import { buildCompetitionHubs } from '../../lib/hubs';

const hubs = buildCompetitionHubs();
const title = 'البطولات | الجداول والمباريات والنتائج - ملخص';
const description = 'صفحات البطولات في ملخص: دوري روشن السعودي والدوري الإنجليزي والإسباني والألماني والإيطالي والفرنسي ودوري الأبطال والبطولات القارية.';
---
<BaseLayout title={title} description={description} section="football">
  <section class="shell section-hero"><span>🏆</span><div><small>Competition Hubs</small><h1>البطولات</h1><p>صفحات دائمة تجمع المباريات والنتائج والفرق والأخبار حسب البطولة.</p></div></section>
  <div class="shell"><LurvuePromo section="football" position="competitions-directory" /></div>
  <section class="shell directory-section">
    <div class="section-title"><div><span class="section-kicker">محدثة من مركز المباريات</span><h2>أهم البطولات</h2></div><a href="/matches/today">مباريات اليوم</a></div>
    {hubs.length ? <div class="directory-grid">{hubs.map((hub) => <a href={`/competitions/${hub.slug}/`}><span>{hub.opportunityScore}/100</span><h3>{hub.name}</h3>{hub.alternateName !== hub.name && <small>{hub.alternateName}</small>}<p>{hub.matches.length} مباراة • {hub.teams.length} فريق</p></a>)}</div> : <div class="empty"><h2>جاري تجهيز صفحات البطولات</h2><p>تظهر الصفحات بعد تحديث مركز المباريات.</p></div>}
  </section>
</BaseLayout>
<style>
.directory-section{padding:34px 0 75px}.directory-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.directory-grid>a{background:linear-gradient(150deg,#10233a,#0a1625);border:1px solid var(--line);border-radius:17px;padding:18px;min-height:145px}.directory-grid>a:hover{color:inherit;border-color:#356086}.directory-grid span{font-size:9px;color:var(--accent);font-weight:900}.directory-grid h3{font-size:21px;margin:7px 0 2px}.directory-grid small{color:var(--muted);font-size:9px}.directory-grid p{color:var(--muted);font-size:11px;margin:14px 0 0}@media(max-width:760px){.directory-grid{grid-template-columns:1fr 1fr}}@media(max-width:470px){.directory-grid{grid-template-columns:1fr}}
</style>
