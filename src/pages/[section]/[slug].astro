---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LurvuePromo from '../../components/LurvuePromo.astro';
import { sectionMap } from '../../data/sections';
import stories from '../../data/stories.json';
import imageManifest from '../../data/image-manifest.json';
import { topicCounts, topicSlug } from '../../lib/content';
import { graphForStory, graphRelatedScore } from '../../lib/content-graph';
import { matchDateArabic, matchStateArabic, matchTimeArabic } from '../../lib/matches';

export function getStaticPaths() {
  return stories.filter((s) => s.status === 'approved' && s.sourceId !== 'molakhas-editorial').map((story) => ({ params: { section: story.section, slug: story.slug }, props: { story } }));
}
const { story } = Astro.props;
const section = sectionMap[story.section];
const siteUrl = (Astro.site ?? new URL(Astro.url.origin)).toString().replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, `${siteUrl}/`).toString();
const sourceHref = story.publisherUrl || story.sourceUrl;
const mediaMap = imageManifest as Record<string, any>;
const media = mediaMap[story.slug] || {};
const imageSrc = media.src || story.image?.src || `/news-images/${story.slug}.webp`;
const fallbackSrc = media.fallbackSrc || `/news-images/${story.slug}.webp`;
const imageUrl = new URL(imageSrc, `${siteUrl}/`).toString();
const imageAlt = media.alt || story.image?.alt || `صورة مرتبطة بخبر ${story.title}`;
const imageCaption = media.caption || story.image?.caption || story.excerpt;
const imageType = media.type || story.image?.type || undefined;
const imageWidth = media.width || story.image?.width || undefined;
const imageHeight = media.height || story.image?.height || undefined;
const seoTitle = story.seoTitle || story.title;
const metaDescription = story.metaDescription || story.excerpt;
const words = story.body.join(' ').split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(words / 180));
const publicStories = stories.filter((s) => s.status === 'approved' && s.sourceId !== 'molakhas-editorial');
const counts = topicCounts(publicStories as any[]);
const graph = graphForStory(story);
const related = publicStories
  .filter((s) => s.slug !== story.slug)
  .map((s) => ({ story: s, score: graphRelatedScore(story, s) }))
  .filter((x) => x.score > 0)
  .sort((a,b)=>b.score-a.score || +new Date(b.story.publishedAt)-+new Date(a.story.publishedAt))
  .slice(0,4)
  .map((x)=>x.story);
const mediaFor = (item) => mediaMap[item.slug] || {};
const imageFor = (item) => mediaFor(item).src || item.image?.src || `/news-images/${item.slug}.webp`;
const fallbackFor = (item) => mediaFor(item).fallbackSrc || `/news-images/${item.slug}.webp`;
const altFor = (item) => mediaFor(item).alt || item.image?.alt || '';

const aboutEntities = [
  ...graph.teams.map((hub) => ({ '@type':'SportsTeam', name:hub.name, url:`${siteUrl}/teams/${hub.slug}` })),
  ...graph.competitions.map((hub) => ({ '@type':'Thing', name:hub.name, url:`${siteUrl}/competitions/${hub.slug}` }))
];
const schema = {
  '@type':'NewsArticle', headline:story.title, description:metaDescription,
  image:[imageUrl], thumbnailUrl:imageUrl, datePublished:story.publishedAt, dateModified:story.generatedAt || story.publishedAt,
  inLanguage:'ar', isAccessibleForFree:true, articleSection:section?.name ?? 'رياضة', keywords:(story.tags || []).join(', '), wordCount:words,
  mainEntityOfPage:{'@type':'WebPage','@id':canonical},
  author:{'@type':'Organization','@id':`${siteUrl}/authors/editorial-team`,name:'فريق تحرير ملخص',url:`${siteUrl}/authors/editorial-team`},
  publisher:{'@type':'Organization','@id':`${siteUrl}/#organization`,name:'ملخص',url:siteUrl,logo:{'@type':'ImageObject',url:`${siteUrl}/brand/molakhas-logo.png`,width:512,height:512}},
  about: aboutEntities.length ? aboutEntities : (story.entities || story.tags || []).slice(0,6).map((name)=>({'@type':'Thing',name})),
  isBasedOn:sourceHref
};
const breadcrumbSchema = {
  '@type':'BreadcrumbList', itemListElement:[
    {'@type':'ListItem',position:1,name:'الرئيسية',item:`${siteUrl}/`},
    {'@type':'ListItem',position:2,name:section?.name ?? 'رياضة',item:`${siteUrl}/${story.section}`},
    {'@type':'ListItem',position:3,name:story.title,item:canonical}
  ]
};
const xShare = `https://twitter.com/intent/tweet?text=${encodeURIComponent(story.title)}&url=${encodeURIComponent(canonical)}`;
const waShare = `https://wa.me/?text=${encodeURIComponent(`${story.title}\n${canonical}`)}`;
const tgShare = `https://t.me/share/url?url=${encodeURIComponent(canonical)}&text=${encodeURIComponent(story.title)}`;
---
<BaseLayout title={`${seoTitle} | ملخص`} description={metaDescription} section={story.section} type="article" publishedAt={story.publishedAt} modifiedAt={story.generatedAt || story.publishedAt} image={imageSrc} imageAlt={imageAlt} imageType={imageType} imageWidth={imageWidth} imageHeight={imageHeight} tags={story.tags || []} schemaExtra={[schema, breadcrumbSchema]}>
  <article class="article shell">
    <nav class="breadcrumbs" aria-label="مسار التنقل"><a href="/">الرئيسية</a><span>←</span><a href={`/${story.section}`}>{section?.name ?? 'رياضة'}</a></nav>
    <header>
      <span class="article-section">{section?.name ?? 'رياضة'}</span>
      <h1>{story.title}</h1>
      <p class="article-deck">{story.excerpt}</p>
      <div class="article-meta"><span>بقلم <a href="/authors/editorial-team">فريق تحرير ملخص</a></span><time datetime={story.publishedAt}>{new Date(story.publishedAt).toLocaleString('ar-SA-u-nu-latn',{dateStyle:'full',timeStyle:'short'})}</time><span>{readingMinutes} د قراءة</span><span>المصدر: <a href={sourceHref} rel="noopener nofollow" target="_blank">{story.sourceName}</a></span></div>
    </header>

    <figure class="article-hero">
      <img src={imageSrc} alt={imageAlt} width={imageWidth || 1200} height={imageHeight || 675} loading="eager" fetchpriority="high" decoding="async" referrerpolicy={media.external ? 'no-referrer' : undefined} onerror={`this.onerror=null;this.src='${fallbackSrc}'`} />
      <figcaption>
        <span>{imageCaption}</span>
        {media.kind === 'source-remote' && <small class="image-credit">الصورة من صفحة المصدر: {media.provider || story.sourceName || 'المصدر الأصلي'} · <a href={media.sourceUrl || sourceHref} target="_blank" rel="noopener nofollow">فتح المصدر</a></small>}
      </figcaption>
    </figure>

    {story.keyPoints?.length >= 2 && <aside class="key-points" aria-label="أهم نقاط الخبر"><strong>الزبدة</strong><ul>{story.keyPoints.map((point)=><li>{point}</li>)}</ul></aside>}

    {(graph.teams.length > 0 || graph.competitions.length > 0) && <nav class="entity-links" aria-label="روابط مرتبطة بالخبر">
      <span>مرتبط بـ</span>
      {graph.teams.map((hub)=><a href={`/teams/${hub.slug}`}>⚽ {hub.name}</a>)}
      {graph.competitions.map((hub)=><a href={`/competitions/${hub.slug}`}>🏆 {hub.name}</a>)}
    </nav>}

    {graph.matches.length > 0 && <section class="story-match-links" aria-label="مباريات مرتبطة بالخبر">
      <div class="story-match-title"><strong>مباريات مرتبطة</strong><a href="/matches/today">مباريات اليوم ←</a></div>
      <div class="story-match-grid">{graph.matches.map((match)=><a class:list={["story-match", { live: match.state === 'live' }]} href={`/matches/${match.slug}`}>
        <div><span>{match.league.name}</span><small>{matchStateArabic(match.state)}</small></div>
        <b>{match.home.name} <em>ضد</em> {match.away.name}</b>
        <footer><strong>{match.state === 'live' || match.state === 'final' ? (match.score || '—') : matchTimeArabic(match.kickoff)}</strong><small>{matchDateArabic(match.kickoff)}</small></footer>
      </a>)}</div>
    </section>}

    <div class="article-body">{story.body.map((paragraph, index) => <>{index === 2 && <LurvuePromo section={story.section} position="article-inline" storySlug={story.slug} keyword={story.focusKeyword} storyTitle={story.title} />}<p>{paragraph}</p></>)}</div>
    <div class="share-row" aria-label="مشاركة الخبر"><strong>شارك الخبر</strong><a href={waShare} target="_blank" rel="noopener">واتساب</a><a href={xShare} target="_blank" rel="noopener">X</a><a href={tgShare} target="_blank" rel="noopener">تيليجرام</a></div>

    <LurvuePromo section={story.section} position="article-end" storySlug={story.slug} keyword={story.focusKeyword} storyTitle={story.title} />

    {story.tags?.length > 0 && <div class="tag-list" aria-label="مواضيع الخبر">{story.tags.map((tag) => { const slug = topicSlug(tag); const available = (counts.get(slug)?.count || 0) >= 2; return available ? <a href={`/topic/${slug}`}>#{tag}</a> : <span>#{tag}</span>; })}</div>}
    <div class="article-source-note"><strong>عن هذا الخبر</strong><p>أعاد فريق ملخص تحرير المعلومات المتاحة بصياغة عربية أصلية، مع بوابة جودة قبل النشر. يمكنك الرجوع إلى صفحة الناشر الأصلية للتحقق من التفاصيل والسياق الكامل.</p><div><a href={sourceHref} target="_blank" rel="noopener nofollow">فتح المصدر الأصلي ←</a><a href="/editorial-policy">سياسة التحرير ←</a><a href="/corrections">طلب تصحيح ←</a></div></div>
    {related.length > 0 && <section class="related"><div class="section-title"><h2>قد يهمك أيضًا</h2><a href={`/${story.section}`}>كل أخبار {section?.name ?? 'القسم'} ←</a></div><div class="related-grid">{related.map((item)=><a class="related-card" href={`/${item.section}/${item.slug}`}><img src={imageFor(item)} alt={altFor(item)} width="1200" height="675" loading="lazy" decoding="async" referrerpolicy={mediaFor(item).external ? 'no-referrer' : undefined} onerror={`this.onerror=null;this.src='${fallbackFor(item)}'`}/><span>{new Date(item.publishedAt).toLocaleDateString('ar-SA-u-nu-latn',{dateStyle:'medium'})}</span><h3>{item.title}</h3><p>{item.excerpt}</p></a>)}</div></section>}
  </article>
</BaseLayout>

<style>
  .article-hero{margin:30px 0 12px}.article-hero img{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;border-radius:20px;border:1px solid var(--line);background:var(--panel)}.article-hero figcaption{margin-top:8px;color:var(--muted);font-size:12px;line-height:1.6;display:grid;gap:4px}.image-credit{font-size:11px}.image-credit a{color:var(--accent)}
  .key-points{margin:25px 0;background:#0d1e31;border:1px solid #29425e;border-radius:18px;padding:20px 24px}.key-points strong{color:var(--accent);font-size:18px}.key-points ul{margin:10px 0 0;padding-right:22px}.key-points li{margin:7px 0;color:#dce6f2}
  .entity-links{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin:18px 0 24px}.entity-links>span{font-size:11px;color:var(--muted)}.entity-links a{font-size:11px;padding:7px 10px;border:1px solid var(--line);border-radius:999px;background:#0a1725}.entity-links a:hover{border-color:var(--accent)}
  .story-match-links{margin:20px 0 28px}.story-match-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:9px}.story-match-title>a{font-size:11px;color:var(--accent)}.story-match-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}.story-match{border:1px solid var(--line);border-radius:15px;background:#091725;padding:14px;color:inherit}.story-match:hover{color:inherit;border-color:#3c6384}.story-match.live{border-color:#ff5b6655}.story-match>div,.story-match footer{display:flex;justify-content:space-between;gap:10px;align-items:center}.story-match span,.story-match small{font-size:9px;color:var(--muted)}.story-match b{display:block;font-size:14px;margin:9px 0}.story-match b em{font-style:normal;color:var(--muted);font-size:9px}.story-match footer{border-top:1px solid var(--line);padding-top:8px}.story-match footer strong{font-size:14px;color:var(--accent)}
  .share-row{display:flex;align-items:center;gap:9px;flex-wrap:wrap;margin:28px 0;padding:14px 0;border-block:1px solid var(--line)}.share-row strong{margin-left:4px}.share-row a{padding:6px 11px;border:1px solid var(--line);border-radius:999px;font-size:12px;color:#dbe7f5;background:#0a1725}.share-row a:hover{border-color:var(--accent)}
  .article-source-note>div{display:flex;gap:14px;flex-wrap:wrap;margin-top:8px}.related-card img{width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;border-radius:10px;margin-bottom:10px}
  @media(max-width:620px){.story-match-grid{grid-template-columns:1fr}}
</style>