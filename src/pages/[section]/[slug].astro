---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LurvuePromo from '../../components/LurvuePromo.astro';
import { sectionMap } from '../../data/sections';
import stories from '../../data/stories.json';
export function getStaticPaths() { return stories.filter((s) => s.status === 'approved').map((story) => ({ params: { section: story.section, slug: story.slug }, props: { story } })); }
const { story } = Astro.props;
const section = sectionMap[story.section];
const schema = { '@context':'https://schema.org', '@type':'NewsArticle', headline:story.title, datePublished:story.publishedAt, dateModified:story.publishedAt, inLanguage:'ar', mainEntityOfPage:new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString(), publisher:{'@type':'Organization',name:'ملخص'}, isBasedOn:story.sourceUrl };
---
<BaseLayout title={`${story.title} | ملخص`} description={story.excerpt} section={story.section}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <article class="article shell">
    <nav class="breadcrumbs"><a href="/">الرئيسية</a><span>←</span><a href={`/${story.section}`}>{section?.name ?? 'رياضة'}</a></nav>
    <header><span class="article-section">{section?.name ?? 'رياضة'}</span><h1>{story.title}</h1><p class="article-deck">{story.excerpt}</p><div class="article-meta"><span>{new Date(story.publishedAt).toLocaleString('ar-SA',{dateStyle:'full',timeStyle:'short'})}</span><span>المصدر: <a href={story.sourceUrl} rel="noopener nofollow" target="_blank">{story.sourceName}</a></span></div></header>
    <div class="article-body">{story.body.map((paragraph, index) => <>{index === 1 && <LurvuePromo section={story.section} />}<p>{paragraph}</p></>)}</div>
    <LurvuePromo section={story.section} />
  </article>
</BaseLayout>
