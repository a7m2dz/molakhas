---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LurvuePromo from '../../components/LurvuePromo.astro';
import { sections } from '../../data/sections';
import stories from '../../data/stories.json';
import imageManifest from '../../data/image-manifest.json';

export function getStaticPaths() {
  return sections.map((section) => ({ params: { section: section.slug }, props: { section } }));
}
const { section } = Astro.props;
const items = stories.filter((story) => story.status === 'approved' && story.sourceId !== 'molakhas-editorial' && story.section === section.slug).sort((a,b)=>+new Date(b.publishedAt)-+new Date(a.publishedAt));
const mediaMap = imageManifest as Record<string, any>;
const mediaFor = (story) => mediaMap[story.slug] || {};
const imageFor = (story) => mediaFor(story).src || story.image?.src || `/news-images/${story.slug}.webp`;
const fallbackFor = (story) => mediaFor(story).fallbackSrc || `/news-images/${story.slug}.webp`;
const altFor = (story) => mediaFor(story).alt || story.image?.alt || '';
---
<BaseLayout title={`${section.name} - آخر الأخبار | ملخص`} description={`${section.description} آخر الأخبار مرتبة من الأحدث مع صور ومصادر واضحة.`} section={section.slug}>
  <header class="section-hero shell"><span>{section.icon}</span><div><small>قسم ملخص</small><h1>{section.name}</h1><p>{section.description}</p><div class="section-count">{items.length} خبر منشور</div></div></header>
  <section class="shell"><LurvuePromo section={section.slug} position="section-top" /></section>
  <section class="shell section-block">
    <div class="section-title"><div><span class="section-kicker">الأحدث أولًا</span><h2>آخر أخبار {section.name}</h2></div></div>
    <div class="story-list media-list">{items.length ? items.map((story) => <article>
      <a class="list-thumb" href={`/${story.section}/${story.slug}`} aria-label={story.title}><img src={imageFor(story)} alt={altFor(story)} width="1200" height="675" loading="lazy" decoding="async" referrerpolicy={mediaFor(story).external ? 'no-referrer' : undefined} onerror={`this.onerror=null;this.src='${fallbackFor(story)}'`} /></a>
      <div class="list-copy"><span class="story-meta">{new Date(story.publishedAt).toLocaleString('ar-SA',{dateStyle:'medium',timeStyle:'short'})}</span><h2><a href={`/${story.section}/${story.slug}`}>{story.title}</a></h2><p>{story.excerpt}</p></div>
      <a class="read-more" href={`/${story.section}/${story.slug}`}>اقرأ ←</a>
    </article>) : <div class="empty"><h2>نجهّز لك التغطية 👀</h2><p>سيظهر أحدث محتوى هذا القسم هنا فور اجتيازه بوابة الجودة.</p></div>}</div>
  </section>
</BaseLayout>

<style>.media-list article{display:grid;grid-template-columns:220px 1fr auto}.list-thumb img{display:block;width:220px;height:124px;object-fit:cover;border-radius:12px}.list-copy{min-width:0}@media(max-width:760px){.media-list article{grid-template-columns:1fr}.list-thumb img{width:100%;height:auto;aspect-ratio:16/9}.read-more{margin-top:4px}}</style>
