{
  "name": "molakhas",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "npm run fotmob:refresh && node scripts/newsroom/source-images.mjs && astro build",
    "preview": "astro preview",
    "fotmob:radar": "node scripts/newsroom/fotmob-radar.mjs",
    "fotmob:refresh": "node scripts/newsroom/fotmob-radar.mjs --write",
    "search:feedback": "node scripts/newsroom/search-console-feedback.mjs",
    "newsroom": "npm run search:feedback && npm run fotmob:refresh && node scripts/newsroom/run.mjs",
    "newsroom:dry": "npm run search:feedback && npm run fotmob:refresh && node scripts/newsroom/run.mjs --dry-run",
    "omniroute:test": "node scripts/newsroom/omniroute-test.mjs",
    "images:generate": "node scripts/newsroom/source-images.mjs",
    "indexnow": "node scripts/newsroom/indexnow.mjs"
  },
  "dependencies": {
    "astro": "^5.13.5",
    "fast-xml-parser": "^5.2.5",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "wrangler": "^4.34.0"
  },
  "engines": { "node": ">=22" }
}
