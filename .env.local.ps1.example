# Optional local-only settings. Copy this file to .env.local.ps1.
# .env.local.ps1 is ignored by Git. Never commit real secrets.

# Only needed if your OmniRoute endpoint requires an API key:
# $env:OMNIROUTE_API_KEY = 'sk-your-omniroute-key'

# Default writer model. auto/best-free prefers the free pool.
# $env:OMNIROUTE_MODEL = 'auto/best-free'

# If the free combo is unavailable or exhausted, fall back to balanced auto routing.
# $env:OMNIROUTE_FALLBACK_MODEL = 'auto'

# Optional request timeout in milliseconds.
# $env:OMNIROUTE_TIMEOUT_MS = '120000'

# Google Search Console feedback loop (recommended for SEO opportunity scoring).
# Use the exact Search Console property identifier. For the Domain property:
# $env:GSC_SITE_URL = 'sc-domain:mulakhas.com'
# $env:GSC_CLIENT_EMAIL = 'service-account@your-project.iam.gserviceaccount.com'
# Keep the private key on one line with literal \n separators; the script expands them safely.
# $env:GSC_PRIVATE_KEY = '-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n'
# Optional tuning:
# $env:GSC_LOOKBACK_DAYS = '28'
# $env:GSC_END_LAG_DAYS = '3'
# $env:GSC_ROW_LIMIT = '10000'
# $env:SEO_OPPORTUNITY_LIMIT = '300'
