# Optional local-only FCC settings. Copy this file to .env.local.ps1.
# .env.local.ps1 is ignored by Git.

# Only needed after enabling Proxy/Auth in FCC Admin:
# $env:FCC_API_KEY = 'YOUR_LOCAL_FCC_PROXY_TOKEN'

# Optional: force a specific FCC model. Leave unset to use the FCC server default.
# $env:FCC_MODEL = 'provider/model-slug'
