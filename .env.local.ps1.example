# Optional local-only OmniRoute settings. Copy this file to .env.local.ps1.
# .env.local.ps1 is ignored by Git.

# Only needed if your OmniRoute endpoint requires an API key:
# $env:OMNIROUTE_API_KEY = 'sk-your-omniroute-key'

# Default writer model. auto/best-free prefers the free pool.
# $env:OMNIROUTE_MODEL = 'auto/best-free'

# If the free combo is unavailable or exhausted, fall back to balanced auto routing.
# $env:OMNIROUTE_FALLBACK_MODEL = 'auto'

# Optional request timeout in milliseconds.
# $env:OMNIROUTE_TIMEOUT_MS = '120000'
